const typeMeta = {
  "easy":       {label:"Easy",              color:"var(--moss)"},
  "long":       {label:"Long run",          color:"var(--teal)"},
  "threshold":  {label:"Threshold",         color:"var(--rust)"},
  "vo2":        {label:"VO2 / speed",       color:"var(--berry)"},
  "hills":      {label:"Hills",             color:"var(--clay)"},
  "fivek":      {label:"5K-specific",       color:"var(--plum)"},
  "race-priority":   {label:"Race — all out",    color:"var(--gold)"},
  "race-controlled": {label:"Race — controlled", color:"var(--gold)"},
  "recovery":   {label:"Recovery",          color:"var(--grey)"},
  "shakeout":   {label:"Shakeout",          color:"var(--moss)"},
  "optional":   {label:"Optional",          color:"var(--grey)"},
};
const strengthMeta = {A:"Strength A", B:"Strength B"};

let activeWeek = 1;

function renderCourseLine(){
  const el = document.getElementById("course-line");
  el.querySelectorAll(".stop").forEach(n=>n.remove());
  weeks.forEach(w=>{
    const btn = document.createElement("button");
    btn.className = "stop" + (w.race ? " is-race":"") + (w.num===activeWeek ? " is-active":"");
    btn.setAttribute("aria-label", "Week "+w.num+(w.race?", "+w.race:""));
    btn.innerHTML = '<span class="dot"></span><span class="wk">Wk '+w.num+'</span>'+(w.race?'<span class="race-name">'+w.race+'</span>':'');
    btn.addEventListener("click", ()=>selectWeek(w.num));
    el.appendChild(btn);
  });
}

function renderTabs(){
  const el = document.getElementById("week-tabs");
  el.innerHTML = "";
  weeks.forEach(w=>{
    const btn = document.createElement("button");
    btn.textContent = "Week "+w.num;
    btn.className = w.num===activeWeek ? "active":"";
    btn.setAttribute("role","tab");
    btn.addEventListener("click", ()=>selectWeek(w.num));
    el.appendChild(btn);
  });
}

function renderWeek(){
  const w = weeks.find(x=>x.num===activeWeek);
  const panel = document.getElementById("week-panel");
  let html = '<div class="week-head">'
    + '<span class="wh-title">Week '+w.num+' — '+w.phase+'</span>'
    + '<span class="wh-dates">'+w.dates+'</span>'
    + '<span class="wh-mi num">'+w.miles+' mi</span>'
    + '</div>';
  html += '<p class="week-note">'+w.note+'</p>';
  w.days.forEach(d=>{
    const meta = typeMeta[d.type];
    const isRace = d.type.startsWith("race");
    html += '<div class="day'+(isRace?" is-race":"")+'">'
      + '<div class="d-when"><div class="d-day">'+d.day+'</div><div class="d-date">'+d.date+'</div><div class="d-mi num">'+d.miles+'</div></div>'
      + '<div class="d-body" style="border-left-color:'+(isRace?"var(--gold)":meta.color)+'">'
      + '<div class="pill-row">'
        + '<span class="pill" style="color:'+meta.color+'">'+meta.label+'</span>'
        + (d.strength ? '<span class="pill" style="color:var(--slate)">'+strengthMeta[d.strength]+'</span>' : '')
      + '</div>'
      + '<div class="d-title">'+d.title+'</div>'
      + '<div class="d-detail">'+d.detail+'</div>'
      + '</div></div>';
  });
  panel.innerHTML = html;
}

function selectWeek(n){
  activeWeek = n;
  renderCourseLine();
  renderTabs();
  renderWeek();
  document.getElementById("week-panel").scrollIntoView({behavior:"smooth", block:"nearest"});
}

renderCourseLine();
renderTabs();
renderWeek();
</script>
